{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-installed.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shell-source-reads.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session|mcp__ccd_session__hand_off_to_session|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-fork-context.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|REPL",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shape.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*[Cc]omment.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-investigation.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
