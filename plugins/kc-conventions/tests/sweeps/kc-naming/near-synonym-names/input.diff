+export const OrderStatusBanner = ({ order }: Props) => {
+  const isShipping = order.status === Status.SHIPPING
+  const isAwaitingPayment = order.status === Status.AWAITING_PAYMENT
+  const hasFailedPayment = order.paymentReason === Reason.PAYMENT_FAILED
+  const hasPaymentError = isAwaitingPayment && hasFailedPayment
+  const canCancel = order.cancellable
+  return <Banner error={hasPaymentError} shipping={isShipping} />
+}
